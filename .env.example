# Local Pharm — environment variables (names only, never commit real values).
# Copy to .env.local for local development. In Vercel: Project → Settings →
# Environment Variables. NEXT_PUBLIC_* are inlined at build time — after any
# change you need a Redeploy (not just Restart).

# Supabase → Project Settings → API (Data API): Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys: Publishable key (sb_publishable_...).
# Never put the secret / service_role key here or anywhere in the app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random string (16+ chars). Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it /api/cron/keepalive always answers 401.
CRON_SECRET=

# Optional, server-only. openFDA drug label endpoint used by the Add → Search
# "Международные базы" block. Default: https://api.fda.gov/drug/label.json
# (no API key). Set only for local tests with a stub; leave unset in Vercel.
# OPENFDA_API_URL=

# Optional. Address printed into box QR stickers, e.g. https://your-app.vercel.app
# Not set → the address the print page is opened at. Set it if the app has
# several addresses (preview deploys, own domain) and stickers must always
# point to one of them. NEXT_PUBLIC_* → Redeploy after a change.
# NEXT_PUBLIC_SITE_URL=

# Weekly e-mail about expiry dates (Phase 6), sent by the daily /api/cron/keepalive on
# Mondays (UTC). All three are needed; if any is missing the e-mail is simply not sent
# (the cron still answers ok and logs which names are missing). Server-only.
# Resend → API Keys. Without your own verified domain Resend sends only to the e-mail
# address of the Resend account owner (use onboarding@resend.dev as MAIL_FROM).
# RESEND_API_KEY=
# "Local Pharm <onboarding@resend.dev>" or a bare address on your verified domain
# MAIL_FROM=
# Recipients, comma separated (up to 10)
# NOTIFY_EMAILS=

# Optional, server-only. Resend endpoint. Default: https://api.resend.com/emails
# Set only for local tests with a stub; leave unset in Vercel.
# RESEND_API_URL=
