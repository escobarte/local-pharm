# Local Pharm — environment variables (names only, never commit real values).
# Copy to .env.local for local development. In Vercel: Project → Settings →
# Environment Variables. NEXT_PUBLIC_* are inlined at build time — after any
# change you need a Redeploy (not just Restart).

# Supabase → Project Settings → API (Data API): Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys: Publishable key (sb_publishable_...).
# Never put the secret / service_role key here or anywhere in the app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random string (16+ chars). Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it /api/cron/keepalive always answers 401.
CRON_SECRET=
